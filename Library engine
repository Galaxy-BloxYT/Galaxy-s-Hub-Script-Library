function Library:InitKeySystem(config)
    config = config or {}
    
    if config.UseKeySystem == false then
        return true
    end

    if config.Whitelist and type(config.Whitelist) == "table" then
        local userId = Player.UserId
        local success, hwid = pcall(function() return gethwid and gethwid() end)
        
        for _, id in ipairs(config.Whitelist) do
            if id == userId or (success and id == hwid) then
                return true
            end
        end
    end

    local KeySystemTitle = config.KeySystemTitle or "Untitled | Key System"
    local KeyType = config.KeyType or "Dynamic"
    local FileName = config.FileName or "GalaxysHubLib_Key.string"
    local StaticKeyBase = config.StaticKeyBase or "KEY-"

    local function GetHWID()
        local success, hwid = pcall(function()
            return gethwid and gethwid() or tostring(Player.UserId)
        end)
        return success and hwid or tostring(Player.UserId)
    end

    local function GenerateKey()
        if KeyType == "Static" then
            return StaticKeyBase .. GetHWID()
        else
            local chars = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
            local key = ""
            math.randomseed(os.time())
            for i = 1, 16 do
                local rand = math.random(1, #chars)
                key = key .. chars:sub(rand, rand)
            end
            return "GALAXY-" .. key
        end
    end

    local CurrentGeneratedKey = GenerateKey()

    local function SaveKey(val)
        pcall(function() writefile(FileName, val) end)
    end

    local function ReadKey()
        local success, data = pcall(function()
            if isfile and isfile(FileName) then return readfile(FileName) end
        end)
        return success and data or nil
    end

    local savedKey = ReadKey()

    if savedKey == CurrentGeneratedKey then
        return true
    end

    local parentGui = getGuiParent()
    if parentGui:FindFirstChild("GalaxyKeySystem") then
        parentGui.GalaxyKeySystem:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "GalaxyKeySystem"
