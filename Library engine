    CheckBtn.MouseButton1Click:Connect(function()
        if KeyBox.Text == CurrentGeneratedKey then
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
            StatusLabel.Text = "Valid Key!"
            SaveKey(KeyBox.Text)
            task.wait(1)
            ScreenGui:Destroy()
            isVerified = true
        else
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            StatusLabel.Text = "Error!: incorrect Key or Key is expired!"
        end
    end)

    local isGenerating = false
    GetKeyBtn.MouseButton1Click:Connect(function()
        if isGenerating then return end
        isGenerating = true
        local countdown = 10
        GetKeyBtn.Active = false
        
        while countdown > 0 do
            StatusLabel.TextColor3 = Color3.fromRGB(0, 242, 255)
            StatusLabel.Text = "Wait, we're  verifying if you're not a bot... (" .. countdown .. "s)"
            task.wait(1)
            countdown = countdown - 1
        end
        
