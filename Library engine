	function Window:Notify(notificationTitle, description, buttonsEnabled, buttons)
		local hasButtons = buttonsEnabled == true and type(buttons) == "table"
		local buttonCount = 0

		if hasButtons then
			for _ in pairs(buttons) do
				buttonCount += 1
			end
		end

		local notificationHeight = hasButtons and (76 + math.max(1, buttonCount) * 30) or 82

		local Notification = create("Frame", {
			Name = "Notification",
			Size = UDim2.new(1, 0, 0, notificationHeight),
			BackgroundColor3 = Color3.fromRGB(29, 29, 35),
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 101,
		}, NotifyHolder)
		addCorner(Notification, 8)
		addStroke(Notification, Color3.fromRGB(220, 220, 230), 1, 0.35)

		local NotificationTitle = create("TextLabel", {
			Name = "Title",
			Position = UDim2.fromOffset(10, 7),
			Size = UDim2.new(1, -20, 0, 24),
			BackgroundTransparency = 1,
			Text = _T(notificationTitle),
			TextColor3 = Color3.fromRGB(250, 250, 255),
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 102,
		}, Notification)

		local Description = create("TextLabel", {
			Name = "Description",
			Position = UDim2.fromOffset(10, 31),
			Size = UDim2.new(1, -20, 0, 36),
			BackgroundTransparency = 1,
			Text = _T(description),
			TextColor3 = Color3.fromRGB(195, 195, 205),
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 102,
		}, Notification)

		Notification.Position = UDim2.fromOffset(310, 0)
		TweenService:Create(
			Notification,
			TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{Position = UDim2.fromOffset(0, 0)}
		):Play()

		local closed = false
		local function closeNotification()
			if closed or not Notification.Parent then
				return
			end

			closed = true
			local tween = TweenService:Create(
				Notification,
				TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{
					Position = UDim2.fromOffset(310, 0),
					BackgroundTransparency = 1,
				}
			)

			tween:Play()
			tween.Completed:Once(function()
				if Notification.Parent then
					Notification:Destroy()
				end
			end)
		end

		if hasButtons and buttonCount > 0 then
			local ButtonHolder = create("Frame", {
				Name = "Buttons",
				Position = UDim2.fromOffset(10, 70),
				Size = UDim2.new(1, -20, 0, buttonCount * 30),
				BackgroundTransparency = 1,
				ZIndex = 102,
			}, Notification)

			create("UIListLayout", {
				Padding = UDim.new(0, 5),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}, ButtonHolder)

			for buttonName, callback in pairs(buttons) do
				local Button = create("TextButton", {
					Name = _T(buttonName),
					Size = UDim2.new(1, 0, 0, 25),
					BackgroundColor3 = Color3.fromRGB(43, 43, 52),
					BorderSizePixel = 0,
					Text = _T(buttonName),
					TextColor3 = Color3.fromRGB(240, 240, 245),
					TextSize = 12,
					Font = Enum.Font.GothamMedium,
					ZIndex = 103,
				}, ButtonHolder)
				addCorner(Button, 5)

				Button.MouseButton1Click:Connect(function()
					safeCallback(callback)
					closeNotification()
				end)
			end
		else
			task.delay(3, closeNotification)
		end

		return Notification
	end

	function Window:SelectTab(tab)
		local target = tab

		if type(tab) == "string" then
			target = self._tabs[tab]
		end

		if type(target) ~= "table" or not target.Frame then
			return false
		end

		for _, tabObject in pairs(self._tabs) do
			if type(tabObject) == "table" and tabObject.Frame then
				tabObject.Frame.Visible = false
				tabObject.Button.BackgroundColor3 = Color3.fromRGB(36, 36, 43)
			end
		end

		target.Frame.Visible = true
		target.Button.BackgroundColor3 = Color3.fromRGB(0, 100, 255)
		self._currentTab = target
		return true
	end

