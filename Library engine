				Button.MouseButton1Click:Connect(function()
					safeCallback(callback)
					closeNotification()
				end)
			end
		else
			task.delay(3, closeNotification)
		end

		return Notification
	end

	function Window:SelectTab(tab)
		local target = tab

		if type(tab) == "string" then
			target = self._tabs[tab]
		end

		if type(target) ~= "table" or not target.Frame then
			return false
		end

		for _, tabObject in pairs(self._tabs) do
			if type(tabObject) == "table" and tabObject.Frame then
				tabObject.Frame.Visible = false
				tabObject.Button.BackgroundColor3 = Color3.fromRGB(36, 36, 43)
			end
		end

		target.Frame.Visible = true
		target.Button.BackgroundColor3 = Color3.fromRGB(0, 100, 255)
		self._currentTab = target
		return true
	end

