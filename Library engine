    CopyBtn.MouseButton1Click:Connect(function()
        local generated = (config.KeyType == "Static") and config.StaticKey or getDynamicKey()
        if setclipboard then
            setclipboard(generated)
            CopyBtn.Text = "Copied!"
            task.delay(2, function() CopyBtn.Text = "Copy" end)
        else
            TextBox.Text = generated
        end
    end)

    SubmitBtn.MouseButton1Click:Connect(function()
        local valid, msg = validateKey(TextBox.Text)
        if valid then
            KeyGui:Destroy()
            keyVerified = true
        else
            SubmitBtn.Text = msg
            task.delay(2, function() SubmitBtn.Text = "Check Key" end)
        end
    end)

    repeat task.wait(0.1) until keyVerified
    return true
end

