function KeySystem.Start(customConfig, customTitle)
    local config = {
        UseKeySystem = customConfig and customConfig.UseKeySystem or true,
        KeyType = customConfig and customConfig.KeyType or "Dynamic",
        StaticKey = customConfig and customConfig.StaticKey or "GALAXY-KEY",
        UseLocalFile = customConfig and customConfig.UseLocalFile ~= nil and customConfig.UseLocalFile or true,
        FileName = customConfig and customConfig.FileName or "GalaxysHubLibCustomKey.string",
        MaxKeyUsesPerDay = customConfig and customConfig.MaxKeyUsesPerDay or 50,
        Whitelist = customConfig and customConfig.Whitelist or {}
    }

    local windowTitle = customTitle or "Untitled | Key System"

    local function isWhitelisted()
        if not config.UseKeySystem then return true end
        for _, id in ipairs(config.Whitelist) do
            if LocalPlayer.UserId == id then return true end
        end
        return false
    end

    local function getDynamicKey()
        local currentDate = os.date("%d%m%Y")
        local cleanHwid = string.sub(string.gsub(getHWID(), "[^%w]", ""), 1, 6):upper()
        return "KEY-" .. cleanHwid .. "-" .. currentDate
    end

    local function checkAndUpdateKeyUsage(inputKey)
        if not config.UseLocalFile then return true, "" end
        local today = os.date("%d%m%Y")
        local data = { key = inputKey, date = today, uses = 0 }
        
        pcall(function()
            if isfile and isfile(config.FileName) then
                local decoded = HttpService:JSONDecode(readfile(config.FileName))
                if decoded and decoded.date == today and decoded.key == inputKey then
                    data = decoded
                end
            end
        end)
        
        if data.uses >= config.MaxKeyUsesPerDay then
            return false, "Daily limit exceeded: (" .. config.MaxKeyUsesPerDay .. " used.)."
        end
        
        data.uses = data.uses + 1
        pcall(function()
            if writefile then
                writefile(config.FileName, HttpService:JSONEncode(data))
            end
        end)
        
        return true, ""
    end

    local function validateKey(inputKey)
        local targetKey = (config.KeyType == "Static") and config.StaticKey or getDynamicKey()
        if inputKey ~= targetKey then return false, "Incorrect Key!" end
        local allowed, msg = checkAndUpdateKeyUsage(inputKey)
        if not allowed then return false, msg end
        return true, "Success!"
    end

    local function tryAutoLogin()
        if not config.UseLocalFile or not isfile or not readfile then return false end
        local success, content = pcall(function() return readfile(config.FileName) end)
        if success and content then
            local successDec, decoded = pcall(function() return HttpService:JSONDecode(content) end)
            if successDec and decoded and decoded.key then
                local valid, _ = validateKey(decoded.key)
                if valid then return true end
            end
        end
        return false
    end

    if not config.UseKeySystem or isWhitelisted() or tryAutoLogin() then
        return true
    end

    local keyVerified = false

    if CoreGui:FindFirstChild("GalaxysKeySystemGui") then CoreGui.GalaxysKeySystemGui:Destroy() end
    
    local KeyGui = Instance.new("ScreenGui")
    KeyGui.Name = "GalaxysKeySystemGui"
    KeyGui.ResetOnSpawn = false
    KeyGui.Parent = CoreGui

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0, 360, 0, 210)
