				TextXAlignment = Enum.TextXAlignment.Left,
				AutoButtonColor = false,
			}, TabFrame)
			addCorner(Toggle, 7)
			addStroke(Toggle, Color3.fromRGB(100, 100, 115), 1, 0.55)
			addPadding(Toggle, 10, 82, 0, 0)

			local Switch = create("Frame", {
				Name = "Switch",
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(1.13, 0, 0, 20),
				Size = UDim2.fromOffset(42, 22),
				BackgroundColor3 = Color3.fromRGB(62, 62, 72),
				BorderSizePixel = 0,
			}, Toggle)
			addCorner(Switch, 11)

			local Knob = create("Frame", {
				Name = "Knob",
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 3, 0.5, 0),
				Size = UDim2.fromOffset(16, 16),
				BackgroundColor3 = Color3.fromRGB(240, 240, 245),
				BorderSizePixel = 0,
			}, Switch)
			addCorner(Knob, 8)

			local function render(instant)
				local switchColor = state and Color3.fromRGB(0, 100, 255) or Color3.fromRGB(62, 62, 72)
				local knobPosition = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)

				if instant then
					Switch.BackgroundColor3 = switchColor
					Knob.Position = knobPosition
				else
					TweenService:Create(Switch, TweenInfo.new(0.16), {
						BackgroundColor3 = switchColor,
					}):Play()
					TweenService:Create(Knob, TweenInfo.new(0.16), {
						Position = knobPosition,
					}):Play()
				end
			end

			render(true)

			Toggle.MouseButton1Click:Connect(function()
				state = not state
				render(false)
				safeCallback(toggleCallback, state)
			end)

			local controller = {}

			function controller:Set(value, fireCallback)
				state = value == true
				render(false)

				if fireCallback ~= false then
					safeCallback(toggleCallback, state)
				end
			end

			function controller:Get()
				return state
			end

			controller.Instance = Toggle
			return controller
		end

		function TabObj:AddSlider(nameText, minimum, maximum, defaultOrCallback, callback)
			minimum = tonumber(minimum) or 0
			maximum = tonumber(maximum) or 100

			if maximum < minimum then
				minimum, maximum = maximum, minimum
			end

			local sliderCallback = callback
			local value = minimum

			if type(defaultOrCallback) == "function" then
				sliderCallback = defaultOrCallback
			elseif tonumber(defaultOrCallback) then
				value = math.clamp(tonumber(defaultOrCallback), minimum, maximum)
			end

			local Slider = create("Frame", {
				Name = "Slider",
				Size = UDim2.new(1, 0, 0, 52),
				BackgroundColor3 = Color3.fromRGB(31, 31, 38),
				BorderSizePixel = 0,
				Active = true,
			}, TabFrame)
			addCorner(Slider, 7)
			addStroke(Slider, Color3.fromRGB(100, 100, 115), 1, 0.55)

			local SliderName = create("TextLabel", {
				Name = "Name",
				Position = UDim2.fromOffset(10, 3),
				Size = UDim2.new(1, -90, 0, 24),
				BackgroundTransparency = 1,
				Text = _T(nameText),
				TextColor3 = Color3.fromRGB(240, 240, 245),
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Slider)

			local ValueLabel = create("TextLabel", {
				Name = "Value",
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -10, 0, 3),
				Size = UDim2.fromOffset(72, 24),
				BackgroundTransparency = 1,
				TextColor3 = Color3.fromRGB(170, 170, 185),
				TextSize = 12,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Right,
			}, Slider)

			local BarBackground = create("Frame", {
				Name = "BarBackground",
				Position = UDim2.fromOffset(10, 33),
				Size = UDim2.new(1, -20, 0, 8),
				BackgroundColor3 = Color3.fromRGB(55, 55, 65),
				BorderSizePixel = 0,
				Active = true,
			}, Slider)
			addCorner(BarBackground, 4)

			local Fill = create("Frame", {
				Name = "Fill",
				Size = UDim2.new(0, 0, 1, 0),
				BackgroundColor3 = Color3.fromRGB(0, 100, 255),
				BorderSizePixel = 0,
			}, BarBackground)
			addCorner(Fill, 4)

			local draggingSlider = false

			local function setFromRatio(ratio, fireCallback)
				ratio = math.clamp(ratio, 0, 1)
				value = math.floor(minimum + ((maximum - minimum) * ratio) + 0.5)
				ValueLabel.Text = tostring(value)

				local normalized = maximum == minimum and 0 or ((value - minimum) / (maximum - minimum))
				Fill.Size = UDim2.new(normalized, 0, 1, 0)

				if fireCallback ~= false then
					safeCallback(sliderCallback, value)
				end
			end

			local function updateFromPosition(position, fireCallback)
				if BarBackground.AbsoluteSize.X <= 0 then
					return
				end

				local ratio = (position.X - BarBackground.AbsolutePosition.X) / BarBackground.AbsoluteSize.X
				setFromRatio(ratio, fireCallback)
			end

			BarBackground.InputBegan:Connect(function(input)
				if isPrimaryInput(input) then
					draggingSlider = true
					updateFromPosition(input.Position, true)
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if draggingSlider
					and (input.UserInputType == Enum.UserInputType.MouseMovement
						or input.UserInputType == Enum.UserInputType.Touch) then
					updateFromPosition(input.Position, true)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if isPrimaryInput(input) then
					draggingSlider = false
				end
			end)

			setFromRatio(maximum == minimum and 0 or ((value - minimum) / (maximum - minimum)), false)

			local controller = {}

			function controller:Set(newValue, fireCallback)
				newValue = math.clamp(tonumber(newValue) or minimum, minimum, maximum)
				local ratio = maximum == minimum and 0 or ((newValue - minimum) / (maximum - minimum))
				setFromRatio(ratio, fireCallback)
			end

			function controller:Get()
				return value
			end

			controller.Instance = Slider
			return controller
		end

		function TabObj:AddTextBox(text, placeholder, optionsOrCallback, callback)
			local options = {}
			local textCallback = callback

			if type(optionsOrCallback) == "function" then
				textCallback = optionsOrCallback
			elseif type(optionsOrCallback) == "table" then
				options = optionsOrCallback
			end

			local Holder = create("Frame", {
				Name = "TextBoxHolder",
				Size = UDim2.new(1, 0, 0, 58),
				BackgroundColor3 = Color3.fromRGB(31, 31, 38),
				BorderSizePixel = 0,
			}, TabFrame)
			addCorner(Holder, 7)
			addStroke(Holder, Color3.fromRGB(100, 100, 115), 1, 0.55)

			local Label = create("TextLabel", {
				Name = "Name",
				Position = UDim2.fromOffset(10, 2),
				Size = UDim2.new(1, -20, 0, 22),
				BackgroundTransparency = 1,
				Text = _T(text),
				TextColor3 = Color3.fromRGB(225, 225, 235),
				TextSize = 12,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Holder)

			local TextBox = create("TextBox", {
				Name = "TextBox",
				Position = UDim2.fromOffset(8, 25),
				Size = UDim2.new(1, -16, 0, 26),
				BackgroundColor3 = Color3.fromRGB(43, 43, 51),
				BorderSizePixel = 0,
				PlaceholderText = _T(placeholder),
				PlaceholderColor3 = Color3.fromRGB(135, 135, 150),
				Text = _T(options.Default or ""),
				TextColor3 = Color3.fromRGB(245, 245, 250),
				TextSize = 12,
				Font = Enum.Font.Gotham,
				ClearTextOnFocus = options.ClearTextOnFocus == true,
				MultiLine = options.MultiLine == true,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Holder)
			addCorner(TextBox, 5)
			addPadding(TextBox, 7, 7, 0, 0)

			TextBox.FocusLost:Connect(function(enterPressed)
				if options.NumbersOnly == true then
					local numeric = TextBox.Text:gsub("[^%d%.%-]", "")
					TextBox.Text = numeric
				end

				safeCallback(textCallback, TextBox.Text, enterPressed)
			end)

			return TextBox
		end

		function TabObj:AddColorSelection(nameText, defaultColor, callback)
			local selectedColor = typeof(defaultColor) == "Color3"
				and defaultColor
				or Color3.fromRGB(255, 255, 255)

			local hue, saturation, value = selectedColor:ToHSV()
			local pickerOpen = false
			local draggingSV = false
			local draggingHue = false

			local Holder = create("Frame", {
				Name = "ColorSelection",
				Size = UDim2.new(1, 0, 0, 40),
				BackgroundColor3 = Color3.fromRGB(31, 31, 38),
				BorderSizePixel = 0,
				ClipsDescendants = true,
			}, TabFrame)
			addCorner(Holder, 7)
			addStroke(Holder, Color3.fromRGB(100, 100, 115), 1, 0.55)

			local NameLabel = create("TextLabel", {
				Name = "Name",
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(1, -60, 0, 40),
				BackgroundTransparency = 1,
				Text = _T(nameText),
				TextColor3 = Color3.fromRGB(240, 240, 245),
				TextSize = 13,
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Holder)

			local Preview = create("TextButton", {
				Name = "Preview",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0, 20),
				Size = UDim2.fromOffset(30, 24),
				BackgroundColor3 = selectedColor,
				BorderSizePixel = 0,
				Text = "",
				AutoButtonColor = false,
			}, Holder)
			addCorner(Preview, 6)
			addStroke(Preview, Color3.fromRGB(235, 235, 240), 1, 0.15)

			local Picker = create("Frame", {
				Name = "Picker",
				Position = UDim2.fromOffset(10, 48),
				Size = UDim2.new(1, -20, 0, 130),
				BackgroundTransparency = 1,
				Visible = false,
			}, Holder)

			local SaturationValue = create("Frame", {
				Name = "SaturationValue",
				Size = UDim2.new(1, -30, 0, 105),
				BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
				BorderSizePixel = 0,
				Active = true,
			}, Picker)
			addCorner(SaturationValue, 5)

			create("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
					ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)),
				}),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}, SaturationValue)

			local BlackOverlay = create("Frame", {
				Name = "BlackOverlay",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BorderSizePixel = 0,
				BackgroundTransparency = 0,
				Active = false,
			}, SaturationValue)
			addCorner(BlackOverlay, 5)

			create("UIGradient", {
				Rotation = 90,
				Color = ColorSequence.new(Color3.new(0, 0, 0)),
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(1, 0),
				}),
			}, BlackOverlay)

			local SVCursor = create("Frame", {
				Name = "Cursor",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(10, 10),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 5,
			}, SaturationValue)
			addCorner(SVCursor, 5)
			addStroke(SVCursor, Color3.new(0, 0, 0), 1, 0)

			local HueBar = create("Frame", {
				Name = "HueBar",
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.fromOffset(20, 105),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Active = true,
			}, Picker)
			addCorner(HueBar, 5)

			create("UIGradient", {
				Rotation = 90,
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0.00, Color3.fromHSV(0.00, 1, 1)),
					ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
					ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
					ColorSequenceKeypoint.new(0.50, Color3.fromHSV(0.50, 1, 1)),
					ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
					ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
					ColorSequenceKeypoint.new(1.00, Color3.fromHSV(1.00, 1, 1)),
				}),
			}, HueBar)

local HueCursor = create("Frame", {
				Name = "Cursor",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, hue, 0),
				Size = UDim2.new(1, 4, 0, 4),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 5,
			}, HueBar)
			addCorner(HueCursor, 2)
			addStroke(HueCursor, Color3.new(0, 0, 0), 1, 0)

			local RGBLabel = create("TextLabel", {
				Name = "RGB",
				Position = UDim2.new(0, 0, 1, -20),
				Size = UDim2.new(1, 0, 0, 20),
				BackgroundTransparency = 1,
				TextColor3 = Color3.fromRGB(180, 180, 195),
				TextSize = 11,
				Font = Enum.Font.Gotham,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, Picker)

			local function updateColor(fireCallback)
				selectedColor = Color3.fromHSV(hue, saturation, value)
				Preview.BackgroundColor3 = selectedColor
				SaturationValue.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
				SVCursor.Position = UDim2.fromScale(saturation, 1 - value)
				HueCursor.Position = UDim2.fromScale(0.5, hue)

				RGBLabel.Text = string.format(
					"RGB: %d, %d, %d",
					math.floor(selectedColor.R * 255 + 0.5),
					math.floor(selectedColor.G * 255 + 0.5),
					math.floor(selectedColor.B * 255 + 0.5)
				)

				if fireCallback ~= false then
					safeCallback(callback, selectedColor)
				end
			end

			local function updateSV(position)
				if SaturationValue.AbsoluteSize.X <= 0 or SaturationValue.AbsoluteSize.Y <= 0 then
					return
				end

				saturation = math.clamp(
					(position.X - SaturationValue.AbsolutePosition.X) / SaturationValue.AbsoluteSize.X,
					0,
					1
				)

				value = 1 - math.clamp(
					(position.Y - SaturationValue.AbsolutePosition.Y) / SaturationValue.AbsoluteSize.Y,
					0,
					1
				)

				updateColor(true)
			end

			local function updateHue(position)
				if HueBar.AbsoluteSize.Y <= 0 then
					return
				end

				hue = math.clamp(
					(position.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y,
					0,
					1
				)

				updateColor(true)
			end

			Preview.MouseButton1Click:Connect(function()
				pickerOpen = not pickerOpen
				Picker.Visible = pickerOpen
				Holder.Size = pickerOpen
					and UDim2.new(1, 0, 0, 188)
					or UDim2.new(1, 0, 0, 40)
			end)

			SaturationValue.InputBegan:Connect(function(input)
				if isPrimaryInput(input) then
					draggingSV = true
					updateSV(input.Position)
				end
			end)

			HueBar.InputBegan:Connect(function(input)
				if isPrimaryInput(input) then
					draggingHue = true
					updateHue(input.Position)
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.MouseMovement
					and input.UserInputType ~= Enum.UserInputType.Touch then
					return
				end

				if draggingSV then
					updateSV(input.Position)
				elseif draggingHue then
					updateHue(input.Position)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if isPrimaryInput(input) then
					draggingSV = false
					draggingHue = false
				end
			end)

			updateColor(false)

			local controller = {}

			function controller:Set(color, fireCallback)
				if typeof(color) ~= "Color3" then
					return
				end

				hue, saturation, value = color:ToHSV()
				updateColor(fireCallback)
			end

			function controller:Get()
				return selectedColor
			end

			controller.Instance = Holder
			return controller
		end

		if not self._currentTab then
			self:SelectTab(TabObj)
		end

		return TabObj
	end

	return Window
end

Library.Construct = BuildUI
Library.CreateWindow = BuildUI

return Library
