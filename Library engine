		function TabObj:AddToggle(text, defaultOrCallback, callback)
			local state = false
			local toggleCallback = callback

			if type(defaultOrCallback) == "function" then
				toggleCallback = defaultOrCallback
			elseif type(defaultOrCallback) == "boolean" then
				state = defaultOrCallback
			end

			local Toggle = create("TextButton", {
				Name = "Toggle",
				Size = UDim2.new(1, 0, 0, 38),
				BackgroundColor3 = Color3.fromRGB(31, 31, 38),
				BorderSizePixel = 0,
